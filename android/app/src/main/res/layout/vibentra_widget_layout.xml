<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:padding="12dp">

    <!-- Album Cover Art -->
    <ImageView
        android:id="@+id/widget_cover"
        android:layout_width="60dp"
        android:layout_height="60dp"
        android:layout_alignParentStart="true"
        android:layout_centerVertical="true"
        android:background="@drawable/widget_cover_bg"
        android:scaleType="centerCrop"
        android:src="@drawable/ic_widget_app_icon"
        android:contentDescription="Album Art" />

    <!-- Center Track Metadata -->
    <LinearLayout
        android:id="@+id/widget_info_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_toEndOf="@id/widget_cover"
        android:layout_toStartOf="@id/widget_controls_container"
        android:layout_centerVertical="true"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="8dp"
        android:orientation="vertical">

        <TextView
            android:id="@+id/widget_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Vibentra Music"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:textStyle="bold"
            android:maxLines="1"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/widget_artist"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Select a song to play"
            android:textColor="#B0B3C6"
            android:textSize="13sp"
            android:maxLines="1"
            android:ellipsize="end"
            android:layout_marginTop="2dp" />

        <TextView
            android:id="@+id/widget_app_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="VIBENTRA"
            android:textColor="#9D4EDD"
            android:textSize="9sp"
            android:textStyle="bold"
            android:layout_marginTop="4dp" />
    </LinearLayout>

    <!-- Right Side Playback Control Buttons -->
    <LinearLayout
        android:id="@+id/widget_controls_container"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentEnd="true"
        android:layout_centerVertical="true"
        android:gravity="center"
        android:orientation="horizontal">

        <ImageButton
            android:id="@+id/widget_btn_prev"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:scaleType="centerInside"
            android:src="@drawable/ic_widget_prev"
            android:contentDescription="Previous Track" />

        <ImageButton
            android:id="@+id/widget_btn_play_pause"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginStart="4dp"
            android:layout_marginEnd="4dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:scaleType="centerInside"
            android:src="@drawable/ic_widget_play"
            android:contentDescription="Play or Pause" />

        <ImageButton
            android:id="@+id/widget_btn_next"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:scaleType="centerInside"
            android:src="@drawable/ic_widget_next"
            android:contentDescription="Next Track" />
    </LinearLayout>

</RelativeLayout>
